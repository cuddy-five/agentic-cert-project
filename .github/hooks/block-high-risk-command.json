{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell",
        "bash": "bash .github/scripts/block-high-risk-command.sh",
        "powershell": "bash .github/scripts/block-high-risk-command.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
